# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase (from https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# Resend (from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=MarketHub

# Stripe (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Gemini (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=xxxxx
